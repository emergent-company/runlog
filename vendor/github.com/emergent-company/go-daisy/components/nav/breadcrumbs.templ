package nav

import (
	ui "github.com/emergent-company/go-daisy/components/ui"
	"github.com/emergent-company/go-daisy/devmode"
)

// breadcrumbItem renders a single breadcrumb <li> for ElementBoundary wrapping.
templ breadcrumbItem(item BreadcrumbItem) {
	<li
		class={ templ.KV("font-medium text-base-content", item.Active) }
	>
		if item.Href != "" {
			<a href={ templ.URL(item.Href) } class={ templ.KV("inline-flex items-center gap-1", item.Icon != "") }>
				if item.Icon != "" {
					@ui.IconSpan(item.Icon, "size-4")
				}
				{ item.Label }
			</a>
		} else {
			<span class={ templ.KV("inline-flex items-center gap-1", item.Icon != "") }>
				if item.Icon != "" {
					@ui.IconSpan(item.Icon, "size-4")
				}
				{ item.Label }
			</span>
		}
	</li>
}

// Breadcrumbs renders a DaisyUI breadcrumb navigation trail.
templ Breadcrumbs(items []BreadcrumbItem, divider BreadcrumbsDivider) {
	<div class="breadcrumbs text-sm"
		style={ templ.KV("--breadcrumbs-separator: '/'", divider == BreadcrumbsDividerSlash), "width: 100%", true }
		{ devmode.Attrs(ctx, "nav/Breadcrumbs")... }>
		<ul>
			for _, item := range items {
				@devmode.ElementBoundary("BreadcrumbItem", breadcrumbItem(item), item)
			}
		</ul>
	</div>
}
