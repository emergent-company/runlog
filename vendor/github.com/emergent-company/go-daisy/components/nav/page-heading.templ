package nav

import "github.com/emergent-company/go-daisy/devmode"

// PageHeadingProps configures a page heading with title and breadcrumbs.
type PageHeadingProps struct {
	Title       string
	Breadcrumbs []BreadcrumbItem
	Attrs       templ.Attributes
}

// PageHeading renders a page heading with title and DaisyUI breadcrumbs.
templ PageHeading(props PageHeadingProps) {
	<div class="flex items-center justify-between" { devmode.Attrs(ctx, "nav/PageHeading")... } { props.Attrs... }>
		<h3 class="text-lg font-medium">{ props.Title }</h3>
		<div class="hidden sm:inline">
			@Breadcrumbs(props.Breadcrumbs, BreadcrumbsDividerDefault)
		</div>
	</div>
}
