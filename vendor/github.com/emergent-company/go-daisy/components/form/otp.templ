package form

import (
	"strconv"

	"github.com/emergent-company/go-daisy/devmode"
)

var otpScriptOnce = templ.NewOnceHandle()

// OTPInput renders a DaisyUI 5 one-time password (OTP) input with
// separate digit fields. digits: number of OTP digits (4-6, default 6).
// Event handler: use otpEventHandlers to wire keyboard navigation.
templ OTPInput(id string, digits int) {
	{{ if digits < 4 || digits > 6 { digits = 6 } }}
	<div class="flex items-center gap-2" { devmode.Attrs(ctx, "form/OTPInput")... }>
		for i := 0; i < digits; i++ {
			<input
				type="text"
				class="input input-bordered w-12 h-14 text-center text-lg font-semibold"
				maxlength="1"
				pattern="[0-9]"
				inputmode="numeric"
				autocomplete="one-time-code"
				id={ id + "-" + strconv.Itoa(i) }
			/>
		}
	</div>
	@otpScriptOnce.Once() {
		<script>
	(function() {
		var id = { "'" + id + "'" };
		var digits = { strconv.Itoa(digits) };
		for (var i = 0; i < digits; i++) (function(idx) {
			var el = document.getElementById(id + '-' + idx);
			if (!el) return;
			el.addEventListener('input', function(e) {
				e.target.value = e.target.value.replace(/[^0-9]/g, '');
				if (e.target.value && idx < digits - 1) {
					var next = document.getElementById(id + '-' + (idx + 1));
					if (next) next.focus();
				}
			});
			el.addEventListener('keydown', function(e) {
				if (e.key === 'Backspace' && !e.target.value && idx > 0) {
					var prev = document.getElementById(id + '-' + (idx - 1));
					if (prev) prev.focus();
				}
			});
			el.addEventListener('paste', function(e) {
				e.preventDefault();
				var paste = (e.clipboardData || window.clipboardData).getData('text').replace(/[^0-9]/g, '');
				for (var j = 0; j < digits && j < paste.length; j++) {
					var target = document.getElementById(id + '-' + j);
					if (target) { target.value = paste[j]; target.dispatchEvent(new Event('input', {bubbles: true})); }
				}
				var nextIdx = Math.min(paste.length, digits - 1);
				var focusEl = document.getElementById(id + '-' + nextIdx);
				if (focusEl) focusEl.focus();
			});
		})(i);
	})();
	</script>
	}
}
