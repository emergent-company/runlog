package form

import (
	ui "github.com/emergent-company/go-daisy/components/ui"
)

var passwordToggleOnce = templ.NewOnceHandle()

templ passwordToggleScript() {
	@passwordToggleOnce.Once() {
		<script>
	if (!window._passToggleInit) {
		window._passToggleInit = true;
		window.togglePasswordVisibility = function(btn) {
			var input = btn.parentElement.querySelector('input');
			if (!input) return;
			if (input.type === 'password') {
				input.type = 'text';
				btn.querySelector('.iconify').classList.remove('lucide--eye');
				btn.querySelector('.iconify').classList.add('lucide--eye-off');
			} else {
				input.type = 'password';
				btn.querySelector('.iconify').classList.remove('lucide--eye-off');
				btn.querySelector('.iconify').classList.add('lucide--eye');
			}
		};
	}
	</script>
	}
}

templ passwordToggleButton() {
	<button
		type="button"
		class="absolute inset-y-0 end-0 z-10 grid w-9 cursor-pointer place-items-center text-base-content/40 transition-colors hover:text-base-content focus-visible:text-base-content"
		onclick="togglePasswordVisibility(this)"
		aria-label="Toggle password visibility"
	>
		@ui.IconSpan("lucide--eye", "size-4")
	</button>
}
