package form

import (
	alpine "github.com/emergent-company/go-daisy/components/alpine"
	"github.com/emergent-company/go-daisy/devmode"
)

// SelectShellProps configures a composable dropdown trigger + panel.
// Children render inside the dropdown panel. Dispatch select-close on pick.
type SelectShellProps struct {
	ID           string
	Label        string
	TriggerLabel string
	Placeholder  string
	ValueExpr    string // Alpine expression for trigger text (e.g. "picked")
	Open         bool   // initial open state
	Disabled     bool
	Class        string
	Attrs        templ.Attributes
}

templ SelectShell(props SelectShellProps) {
	<div
		{ alpine.XData(alpine.Toggle(props.Open))... }
		{ alpine.Escape("open = false")... }
		class={ "relative", templ.KV(props.Class, props.Class != "") }
		{ devmode.Attrs(ctx, "form/SelectShell")... }
		{ props.Attrs... }
	>
		if props.Label != "" {
			<label for={ props.ID + "-trigger" } class="text-sm font-medium text-base-content/70 mb-1 block">
				{ props.Label }
			</label>
		}
		<button
			type="button"
			id={ props.ID + "-trigger" }
			class={ "flex items-center justify-between gap-2 w-full select select-bordered text-left",
				templ.KV("select-disabled", props.Disabled) }
			disabled?={ props.Disabled }
			@click="open = !open"
			aria-haspopup="listbox"
			:aria-expanded="open"
		>
			<span class="block truncate flex-1" x-text={ props.ValueExpr }>
				{ props.Placeholder }
			</span>
			<svg :class="open ? 'rotate-180' : ''" class="size-4 shrink-0 text-base-content/40 transition-transform" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
				<path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd"/>
			</svg>
		</button>
		<div
			x-show="open"
			x-transition:enter="transition ease-out duration-150"
			x-transition:enter-start="opacity-0 scale-95"
			x-transition:enter-end="opacity-100 scale-100"
			x-transition:leave="transition ease-in duration-100"
			x-transition:leave-start="opacity-100 scale-100"
			x-transition:leave-end="opacity-0 scale-95"
			@click.outside="open = false"
			class="absolute z-20 mt-1 w-full bg-base-100 border border-base-200 rounded-box shadow-lg"
			role="listbox"
			style="display:none"
		>
			{ children... }
		</div>
	</div>
}
