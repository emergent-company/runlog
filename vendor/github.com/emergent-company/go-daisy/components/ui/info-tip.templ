package ui

import "github.com/emergent-company/go-daisy/devmode"

// InfoTipProps configures an InfoTip.
type InfoTipProps struct {
	// Position is the tooltip placement: "top" (default), "bottom", "left"
	// or "right".
	Position string
}

// InfoTip renders a CSS-only (zero-JS) daisyUI tooltip wrapping an info icon.
// Distinct from ui.Tooltip, which is Popover-based.
//
//	@ui.InfoTip("Deploys take ~2 minutes")
templ InfoTip(tip string, props ...InfoTipProps) {
	{{ var p InfoTipProps
	if len(props) > 0 { p = props[0] }
	pos := p.Position
	if pos == "" { pos = "top" } }}
	<span class={ "tooltip tooltip-"+pos } data-tip={ tip } { devmode.Attrs(ctx, "ui/InfoTip")... }>
		@IconSpan("lucide--info", "size-3.5 shrink-0 text-base-content/40 cursor-help")
	</span>
}
