package ui

import "github.com/emergent-company/go-daisy/devmode"

// Alert renders a DaisyUI alert banner.
// style controls the visual variant (solid/soft/outline/dash).
// Set icon to a Lucide icon suffix (e.g. "lucide--circle-check") to show an icon.
// Leave icon empty for a text-only alert.
// attrs is optional; pass nil when not needed.
templ Alert(typ AlertType, icon string, message string, attrs templ.Attributes) {
	<div role="alert" class={ "alert", templ.KV(string(typ), typ != "") } { devmode.Attrs(ctx, "ui/Alert")... } { attrs... }>
		if icon != "" {
			@IconSpan(icon, "size-5")
		}
		<span>{ message }</span>
	</div>
}

// AlertStyled renders a DaisyUI alert with both type and style.
templ AlertStyled(typ AlertType, style AlertStyle, icon string, message string, attrs templ.Attributes) {
	<div role="alert" class={ "alert", templ.KV(string(typ), typ != ""), templ.KV(string(style), style != "") } { devmode.Attrs(ctx, "ui/AlertStyled")... } { attrs... }>
		if icon != "" {
			@IconSpan(icon, "size-5")
		}
		<span>{ message }</span>
	</div>
}

// InlineAlert is a backwards-compatible alias for Alert without an icon.
// Deprecated: use Alert(typ, "", message, nil) directly.
templ InlineAlert(typ AlertType, message string) {
	@Alert(typ, "", message, nil)
}

// InlineAlertWithIcon is a backwards-compatible alias for Alert with an icon.
// Deprecated: use Alert(typ, icon, message, nil) directly.
templ InlineAlertWithIcon(typ AlertType, icon string, message string) {
	@Alert(typ, icon, message, nil)
}
