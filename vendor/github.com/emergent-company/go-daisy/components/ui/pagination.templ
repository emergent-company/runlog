package ui

import (
	"fmt"
	"strconv"

	"github.com/emergent-company/go-daisy/devmode"
)

// PaginationStyle controls the button shape variant.
type PaginationStyle string

const (
	// PaginationStyleSquare renders join-based square buttons with outline.
	PaginationStyleSquare PaginationStyle = "square"
	// PaginationStyleCircle renders standalone circle buttons with ghost/primary fill.
	PaginationStyleCircle PaginationStyle = "circle"
)

// PaginationProps holds all data needed to render a full pagination strip.
type PaginationProps struct {
	CurrentPage int
	TotalPages  int
	TotalItems  int64
	PageSize    int
	BaseURL     string           // include all query params except "page", e.g. "/app/cases?status=active"
	TargetID    string
	Style       PaginationStyle  // "square" (default) or "circle"
	Attrs       templ.Attributes // optional extra HTML attributes on the outer wrapper, e.g. {"data-testid": "pagination"}
}

// StartItem returns the 1-based index of the first item on the current page.
func (p PaginationProps) StartItem() int64 {
	if p.TotalItems == 0 {
		return 0
	}
	return int64((p.CurrentPage-1)*p.PageSize) + 1
}

// EndItem returns the 1-based index of the last item on the current page.
func (p PaginationProps) EndItem() int64 {
	end := int64(p.CurrentPage * p.PageSize)
	if end > p.TotalItems {
		return p.TotalItems
	}
	return end
}

// pageURL appends or replaces the page param in a URL string.
func pageURL(base string, page int) string {
	return fmt.Sprintf("%s&page=%d", base, page)
}

// PaginationWithProps renders a pagination bar with item count summary.
// Style controls the button variant: "square" (join-based outline) or "circle" (ghost/primary).
templ PaginationWithProps(props PaginationProps) {
	if props.TotalPages > 1 {
		<div class="border-base-200 flex flex-wrap items-center justify-between gap-2 border-t border-dashed p-5" { devmode.Attrs(ctx, "ui/PaginationWithProps")... } { props.Attrs... }>
			if props.TotalItems > 0 {
				<p class="text-base-content/70 text-sm">
					Showing
					<span class="text-base-content font-medium">{ strconv.FormatInt(props.StartItem(), 10) }–{ strconv.FormatInt(props.EndItem(), 10) }</span>
					out of
					<span class="text-base-content font-medium">{ strconv.FormatInt(props.TotalItems, 10) }</span>
				</p>
			}
			if props.Style == PaginationStyleCircle {
				@circleButtons(props)
			} else {
				@squaredButtons(props)
			}
		</div>
	}
}

// Pagination renders a join-based square pagination strip.
// Deprecated: use PaginationWithProps with Style=PaginationStyleSquare instead.
templ Pagination(currentPage int, totalPages int, baseURL string, targetID string) {
	@PaginationWithProps(PaginationProps{
		CurrentPage: currentPage,
		TotalPages:  totalPages,
		BaseURL:     baseURL,
		TargetID:    targetID,
	})
}

// PaginationCircle renders a circle-style pagination button strip.
// Deprecated: use PaginationWithProps with Style=PaginationStyleCircle instead.
templ PaginationCircle(currentPage int, totalPages int, baseURL string, targetID string) {
	@PaginationWithProps(PaginationProps{
		CurrentPage: currentPage,
		TotalPages:  totalPages,
		BaseURL:     baseURL,
		TargetID:    targetID,
		Style:       PaginationStyleCircle,
	})
}

// squaredButtons renders the Pagination default (square) button strip inside a join div.
templ squaredButtons(props PaginationProps) {
	<div class="join">
		<a
			class={ "btn btn-square btn-sm btn-outline border-base-300 join-item",
				templ.KV("btn-disabled", props.CurrentPage <= 1) }
			if props.CurrentPage > 1 {
				href={ templ.URL(pageURL(props.BaseURL, props.CurrentPage-1)) }
				hx-get={ pageURL(props.BaseURL, props.CurrentPage-1) }
				hx-target={ "#" + props.TargetID }
				hx-swap="outerHTML"
				hx-push-url="true"
			}
			aria-label="Previous page"
		>
			@IconSpan("lucide--arrow-left", "size-4")
		</a>
		for p := 1; p <= props.TotalPages; p++ {
			<a
				class={ "btn btn-square btn-sm btn-outline border-base-300 join-item",
					templ.KV("btn-active", p == props.CurrentPage) }
				href={ templ.URL(pageURL(props.BaseURL, p)) }
				hx-get={ pageURL(props.BaseURL, p) }
				hx-target={ "#" + props.TargetID }
				hx-swap="outerHTML"
				hx-push-url="true"
			>
				{ strconv.Itoa(p) }
			</a>
		}
		<a
			class={ "btn btn-square btn-sm btn-outline border-base-300 join-item",
				templ.KV("btn-disabled", props.CurrentPage >= props.TotalPages) }
			if props.CurrentPage < props.TotalPages {
				href={ templ.URL(pageURL(props.BaseURL, props.CurrentPage+1)) }
				hx-get={ pageURL(props.BaseURL, props.CurrentPage+1) }
				hx-target={ "#" + props.TargetID }
				hx-swap="outerHTML"
				hx-push-url="true"
			}
			aria-label="Next page"
		>
			@IconSpan("lucide--arrow-right", "size-4")
		</a>
	</div>
}

// circleButtons renders the PaginationCircle-style button strip.
templ circleButtons(props PaginationProps) {
	<div class="inline-flex items-center gap-1">
		<a
			class={ "btn btn-circle sm:btn-sm btn-xs btn-ghost",
				templ.KV("btn-disabled", props.CurrentPage <= 1) }
			if props.CurrentPage > 1 && props.BaseURL != "" {
				href={ templ.URL(pageURL(props.BaseURL, props.CurrentPage-1)) }
				hx-get={ pageURL(props.BaseURL, props.CurrentPage-1) }
				hx-target={ "#" + props.TargetID }
				hx-swap="outerHTML"
				hx-push-url="true"
			}
			aria-label="Previous page"
		>
			@IconSpan("lucide--chevron-left", "")
		</a>
		for p := 1; p <= props.TotalPages; p++ {
			<a
				class={ "btn btn-circle sm:btn-sm btn-xs",
					templ.KV("btn-primary", p == props.CurrentPage),
					templ.KV("btn-ghost", p != props.CurrentPage) }
				if props.BaseURL != "" {
					href={ templ.URL(pageURL(props.BaseURL, p)) }
					hx-get={ pageURL(props.BaseURL, p) }
					hx-target={ "#" + props.TargetID }
					hx-swap="outerHTML"
					hx-push-url="true"
				}
			>
				{ strconv.Itoa(p) }
			</a>
		}
		<a
			class={ "btn btn-circle sm:btn-sm btn-xs btn-ghost",
				templ.KV("btn-disabled", props.CurrentPage >= props.TotalPages) }
			if props.CurrentPage < props.TotalPages && props.BaseURL != "" {
				href={ templ.URL(pageURL(props.BaseURL, props.CurrentPage+1)) }
				hx-get={ pageURL(props.BaseURL, props.CurrentPage+1) }
				hx-target={ "#" + props.TargetID }
				hx-swap="outerHTML"
				hx-push-url="true"
			}
			aria-label="Next page"
		>
			@IconSpan("lucide--chevron-right", "")
		</a>
	</div>
}
