package ui

import (
	"github.com/emergent-company/go-daisy/components/stimulus"
	"github.com/emergent-company/go-daisy/devmode"
)

// StimulusThemeToggle renders a sun/moon theme toggle using Stimulus controller.
//
// Deprecated: use ThemeToggle(ThemeToggleProps{Driver: "stimulus"}) instead.
// Note: the actual implementation lives in theme-toggle.templ. This declaration
// is kept for backward compatibility; the function is defined in theme-toggle.templ.

// StimulusClipboardButton renders a copy-to-clipboard button using Stimulus.
// Note: Stimulus-only — no vanilla or Alpine equivalents exist. Uses the
// go-daisy-controllers.js ClipboardController.
templ StimulusClipboardButton(text string, label string) {
	<button
		type="button"
		{ stimulus.Controller("clipboard")... }
		{ stimulus.Action("click", "clipboard", "copy")... }
		{ stimulus.Value("clipboard", "text", text)... }
		class="btn btn-sm btn-ghost"
		{ devmode.Attrs(ctx, "ui/StimulusClipboardButton")... }
	>
		@IconSpan("lucide--copy", "size-4")
		<span>{ label }</span>
	</button>
}
