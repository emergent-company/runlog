package ui

import "github.com/emergent-company/go-daisy/devmode"

// ThemeInputType determines the HTML input type for a theme controller.
type ThemeInputType string

const (
	ThemeCheckbox ThemeInputType = "checkbox"
	ThemeRadio    ThemeInputType = "radio"
)

// ThemeControllerProps configures a ThemeController component.
// When Label is empty, renders the button variant (pill button for theme picker grids).
// When Label is set, renders the full controller with label text.
type ThemeControllerProps struct {
	Theme     string
	InputType ThemeInputType
	Label     string // empty = button variant
	Checked   bool
}

// ThemeController renders a DaisyUI theme-controller input.
// Supports two variants: full controller with label (Label != ""), or pill button (Label == "").
templ ThemeController(props ThemeControllerProps) {
	if props.Label == "" {
		// Button variant (pill button for theme picker grids)
		<div
			class="outline outline-2 outline-base-content outline-offset-2 overflow-hidden rounded-lg"
			{ devmode.Attrs(ctx, "ui/ThemeControllerBtn")... }
		>
			<input
				type="radio"
				name="theme-controller"
				class="theme-controller btn btn-sm"
				aria-label={ props.Theme }
				value={ props.Theme }
				checked?={ props.Checked }
			/>
		</div>
	} else {
		// Full controller with label
		<div class="form-control" { devmode.Attrs(ctx, "ui/ThemeController")... }>
			<label class="label cursor-pointer gap-3">
				<span class="label-text">{ props.Label }</span>
				<input
					type={ string(props.InputType) }
					name="theme-controller"
					class="theme-controller"
					value={ props.Theme }
					checked?={ props.Checked }
				/>
			</label>
		</div>
	}
}
