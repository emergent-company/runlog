package ui

import "github.com/emergent-company/go-daisy/devmode"

// EmptyStateVariant selects the visual scale of an empty state / call to action.
type EmptyStateVariant string

const (
	// EmptyStateCompact is the zero-value default: a compact, in-card empty state.
	EmptyStateCompact EmptyStateVariant = ""
	// EmptyStateHero is a large, page-level call-to-action hero.
	EmptyStateHero EmptyStateVariant = "hero"
)

// EmptyStateIconStyle selects how the leading icon is presented.
type EmptyStateIconStyle string

const (
	// EmptyStateIconMuted is the zero-value default: a plain, muted icon.
	EmptyStateIconMuted EmptyStateIconStyle = ""
	// EmptyStateIconTile wraps the icon in a tinted, rounded icon tile.
	EmptyStateIconTile EmptyStateIconStyle = "tile"
)

// EmptyStateHeading is the semantic heading level rendered for the title.
type EmptyStateHeading string

const (
	EmptyStateHeadingH2 EmptyStateHeading = "h2"
	EmptyStateHeadingH3 EmptyStateHeading = "h3"
)

// EmptyStateProps configures an EmptyState.
type EmptyStateProps struct {
	Icon        string // lucide icon prefix, e.g. "lucide--server"
	Title       string
	Description string
	// Variant selects the scale: EmptyStateCompact (default) or EmptyStateHero.
	Variant EmptyStateVariant
	// IconStyle selects the icon presentation: muted (default) or tinted tile.
	IconStyle EmptyStateIconStyle
	// Heading is the semantic title level. Empty defaults to h3 on the compact
	// scale and h2 on the hero scale; pick another level to fit the page outline.
	Heading EmptyStateHeading
	// Bordered renders the empty state inside a card-border card shell.
	Bordered bool
	// ActionHref + ActionLabel render a convenience primary action button
	// (e.g. "Add your first provider"). Children passed to EmptyState render
	// alongside it in the same action area — use them for hx-get buttons,
	// secondary links or badges.
	ActionHref  string
	ActionLabel string
	ActionIcon  string // optional lucide icon shown inside the convenience action
	Class       string // additional CSS classes appended to the content column
	Attrs       templ.Attributes
}

// EmptyState renders a centered empty-state placeholder or call to action with
// a guaranteed vertical rhythm between icon, title, description and action —
// callers never add their own spacing. Two scales share one visual language:
//
//   - EmptyStateCompact (default): muted icon, base-size title (h3 by default),
//     for bordered in-card empty states.
//   - EmptyStateHero: larger padding and title (h2 by default), typically with
//     EmptyStateIconTile for a tinted icon tile, for page-level CTA heroes.
//
// Callers pass a trailing element block (buttons, links, badges) which lands in
// the action area below the description, spaced automatically. Children flow
// through the templ children context (like every other go-daisy component), so
// EmptyState itself declares no children parameter. The action area is hidden
// when empty so plain empty states render no stray gap.
templ EmptyState(props EmptyStateProps) {
	{{ pad := emptyStatePadding(props) }}
	if props.Bordered {
		@CardRaw("card-border", "px-0 py-0", props.Attrs) {
			@emptyStateBody(props, pad, nil) {
				{ children... }
			}
		}
	} else {
		@emptyStateBody(props, pad, props.Attrs) {
			{ children... }
		}
	}
}

// emptyStateBody is the shared centered content column rendered by both
// chrome branches of EmptyState. Spacing classes come from the scale helpers
// so icon → title → description → action rhythm is identical no matter which
// chrome or scale is used.
templ emptyStateBody(props EmptyStateProps, pad string, attrs templ.Attributes) {
	{{ hero := props.Variant == EmptyStateHero
		iconMB := emptyStateIconMargin(props.Variant)
		titleMB := emptyStateTitleMargin(props.Variant)
		titleClass := emptyStateTitleClass(props.Variant)
		descClass := emptyStateDescClass(props.Variant)
		ctaMT := emptyStateCtaMargin(props.Variant)
		tileClass := emptyStateTileClass(props.Variant)
		tileIcon := emptyStateTileIconClass(props.Variant)
		heading := props.Heading
		if heading == "" {
			if hero { heading = EmptyStateHeadingH2 } else { heading = EmptyStateHeadingH3 }
		}
		titleSpaced := props.Description != "" || (props.ActionLabel != "" && props.ActionHref != "") }}
	<div class={ "flex flex-col items-center text-center", pad, props.Class }
		{ devmode.Attrs(ctx, "ui/EmptyState")... }
		{ attrs... }>
		if props.Icon != "" {
			<div class={ "flex justify-center", iconMB }>
				if props.IconStyle == EmptyStateIconTile {
					<div class={ "grid place-items-center border border-primary/15 bg-primary/10 text-primary", tileClass }>
						@IconSpan(props.Icon, tileIcon)
					</div>
				} else {
					@IconSpan(props.Icon, "size-12", "text-base-content/20")
				}
			</div>
		}
		if props.Title != "" {
			if heading == EmptyStateHeadingH2 {
				<h2 class={ titleClass, templ.KV(titleMB, titleSpaced) }>{ props.Title }</h2>
			} else {
				<h3 class={ titleClass, templ.KV(titleMB, titleSpaced) }>{ props.Title }</h3>
			}
		}
		if props.Description != "" {
			<p class={ descClass }>{ props.Description }</p>
		}
		// Action area: always present so trailing children keep the guaranteed
		// gap; hidden when nothing renders inside it.
		<div class={ "flex flex-wrap items-center justify-center gap-2 [&:empty]:hidden", ctaMT }>
			if props.ActionLabel != "" && props.ActionHref != "" {
				@Button(ButtonProps{
					Type:    ButtonTypeLink,
					Href:    props.ActionHref,
					Variant: ButtonPrimary,
					Size:    emptyStateActionSize(props.Variant),
					Icon:    props.ActionIcon,
				}) {
					{ props.ActionLabel }
				}
			}
			{ children... }
		</div>
	</div>
}

// emptyStatePadding returns the outer padding for a given scale + chrome.
func emptyStatePadding(props EmptyStateProps) string {
	if props.Variant == EmptyStateHero {
		if props.Bordered {
			return "p-10 sm:p-14"
		}
		return "px-6 py-16"
	}
	if props.Bordered {
		return "p-8"
	}
	return "px-4 py-16"
}

// emptyStateTitleClass returns the title type scale for a variant.
func emptyStateTitleClass(v EmptyStateVariant) string {
	if v == EmptyStateHero {
		return "text-xl font-semibold tracking-tight text-base-content"
	}
	return "text-base font-semibold text-base-content"
}

// emptyStateDescClass returns the description type scale for a variant.
func emptyStateDescClass(v EmptyStateVariant) string {
	if v == EmptyStateHero {
		return "text-sm text-base-content/55 max-w-md leading-relaxed"
	}
	return "text-sm text-base-content/50 max-w-md leading-relaxed"
}

// emptyStateIconMargin is the gap below the icon (icon → title).
func emptyStateIconMargin(v EmptyStateVariant) string {
	if v == EmptyStateHero {
		return "mb-5"
	}
	return "mb-4"
}

// emptyStateTitleMargin is the gap below the title (title → description).
func emptyStateTitleMargin(v EmptyStateVariant) string {
	if v == EmptyStateHero {
		return "mb-2"
	}
	return "mb-1"
}

// emptyStateCtaMargin is the guaranteed gap above the action area
// (description → action) — the spacing callers must not have to manage.
func emptyStateCtaMargin(v EmptyStateVariant) string {
	if v == EmptyStateHero {
		return "mt-7"
	}
	return "mt-6"
}

// emptyStateTileClass returns the tinted tile shape for a variant.
func emptyStateTileClass(v EmptyStateVariant) string {
	if v == EmptyStateHero {
		return "size-14 rounded-2xl"
	}
	return "size-12 rounded-xl"
}

// emptyStateTileIconClass returns the icon size inside the tinted tile.
func emptyStateTileIconClass(v EmptyStateVariant) string {
	if v == EmptyStateHero {
		return "size-7"
	}
	return "size-6"
}

// emptyStateActionSize sizes the convenience action button per scale.
func emptyStateActionSize(v EmptyStateVariant) ButtonSize {
	if v == EmptyStateHero {
		return ButtonMD
	}
	return ButtonSM
}
