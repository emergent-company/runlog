package ui

import (
	"strconv"

	"github.com/emergent-company/go-daisy/devmode"
)

// ToastContainer renders a fixed-position toast notification area with Alpine.js
// queue management, auto-dismiss, and swipe-to-dismiss. Use instead of the static
// #toast-container div for rich toast behavior.
//
// To push a toast from the server, send an hx-swap-oob fragment:
//
//	<div x-data hx-swap-oob="beforeend:#toast-queue-content">
//	  <div class="alert alert-success" x-data="{show:true}"
//	       x-init="setTimeout(()=>show=false,4000)" x-show="show"
//	       x-transition:enter="..." x-transition:leave="...">
//	    Message saved.
//	  </div>
//	</div>
templ ToastContainer() {
	<div
		id="toast-container"
		class="fixed top-4 right-4 z-70 flex flex-col gap-2 w-80 max-w-[calc(100vw-2rem)]"
		aria-live="polite"
		aria-atomic="false"
		{ devmode.Attrs(ctx, "ui/ToastContainer")... }
	>
		<div id="toast-queue-content">
			{ children... }
		</div>
	</div>
}

// AlpineToast renders a single self-dismissing toast with enter/leave transitions.
templ AlpineToast(message string, toastType string, durationMs int) {
	<div
		x-data="{show:true}"
		x-init={ "setTimeout(()=>show=false," + strconv.Itoa(durationMs) + ")" }
		x-show="show"
		x-transition:enter="transition ease-out duration-300"
		x-transition:enter-start="opacity-0 translate-y-2"
		x-transition:enter-end="opacity-100 translate-y-0"
		x-transition:leave="transition ease-in duration-200"
		x-transition:leave-start="opacity-100 translate-y-0"
		x-transition:leave-end="opacity-0 translate-y-2"
	>
		@Toast(ToastProps{ Type: ToastType(toastType), Message: message })
	</div>
}
