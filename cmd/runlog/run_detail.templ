package main

import (
	"fmt"

	"github.com/emergent-company/go-daisy/components/table"
	"github.com/emergent-company/go-daisy/components/ui"
	runlog "github.com/emergent-company/runlog"
)

templ RunDetailPage(data runDetailData) {
	@AppPage(fmt.Sprintf("Runlog - %s - Run %d", appName(), data.Run.ID), sidebarGroups) {
		@runDetailContent(data)
	}
}

templ RunDetailContent(data runDetailData) {
	@runDetailContent(data)
}

templ runDetailContent(data runDetailData) {
	<div data-testid="run-detail-content">
		<div class="flex items-center gap-4 mb-6">
			@backButton(TestDetailURL(data.Run.TestName))
			<h1 class="text-2xl font-bold" data-testid="run-id">Run { fmt.Sprintf("%d", data.Run.ID) }</h1>
			if !data.IsActive {
				<button class="btn btn-primary btn-sm"
					hx-post={ LaunchURL(data.Run.TestName) }
					hx-target="#launch-area"
				>Rerun</button>
			}
		</div>
		<div id="launch-area" class="hidden"></div>
		<div class="mb-4">
			<div class="text-xs text-base-content/50 font-mono truncate" title="file">{ testNameFile(data.Run.TestName) }</div>
			<div class="text-lg font-semibold break-all" data-testid="run-test-name">{ testNameOnly(data.Run.TestName) }</div>
		</div>
		if data.Run.Description != nil {
			<div class="mb-4 card bg-base-100 border border-base-200 shadow-sm">
				<div class="card-body p-3">
					<p class="text-sm">{ data.Run.Description.Summary }</p>
					if len(data.Run.Description.Bullets) > 0 {
						<ul class="list-disc list-inside text-sm text-base-content/60 space-y-0.5 mt-1">
							for _, b := range data.Run.Description.Bullets {
								<li>{ b }</li>
							}
						</ul>
					}
				</div>
			</div>
		}
		<div class={ statsGridClass(3) } data-testid="run-stat-cards">
			<div class="card bg-base-100 border border-base-200 shadow-sm">
				<div class="card-body p-4">
					<h2 class="card-title text-base font-semibold text-base-content mb-1">Status</h2>
					if data.IsActive {
						<div class="flex items-center gap-2">
							<span class="loading loading-spinner loading-sm"></span>
							<span class="text-sm font-semibold text-primary">Running...</span>
						</div>
					} else {
						@runStatusBadge(data.Run)
					}
				</div>
			</div>
			@statItemCard(statItem{Label: "Duration", Value: runDuration(data.Run)})
			@statItemCard(statItem{Label: "Started", Value: formatTime(data.Run.StartedAt, TimeFull)})
		</div>
		if data.Run.Experiment != nil && *data.Run.Experiment != "" {
			<div class="mb-6">
				<div class="card bg-base-100 border border-base-200 shadow-sm">
					<div class="card-body p-4">
						<h2 class="card-title text-sm font-semibold text-base-content mb-1">Experiment</h2>
						<a data-testid="experiment-link" href={ "/ui/experiments/" + *data.Run.Experiment } class="badge badge-primary badge-sm hover:badge-outline" { NavRowAttrs("/ui/experiments/" + *data.Run.Experiment)... }>{ *data.Run.Experiment }</a>
					</div>
				</div>
			</div>
		}
		if data.Run.AppVersion != nil && *data.Run.AppVersion != "" {
			<div class="mb-6">
				<div class="card bg-base-100 border border-base-200 shadow-sm">
					<div class="card-body p-4">
						<h2 class="card-title text-sm font-semibold text-base-content mb-1">App Version</h2>
						<span class="badge badge-outline badge-sm font-mono">{ *data.Run.AppVersion }</span>
					</div>
				</div>
			</div>
		}
		if data.Run.TestVersion != nil && *data.Run.TestVersion != "" {
			<div class="mb-6">
				<div class="card bg-base-100 border border-base-200 shadow-sm">
					<div class="card-body p-4">
						<h2 class="card-title text-sm font-semibold text-base-content mb-1">Test Version</h2>
						<span class="badge badge-outline badge-sm font-mono">{ *data.Run.TestVersion }</span>
					</div>
				</div>
			</div>
		}
		if data.Run.FinishedAt != nil && hasCostData(data.Run) {
			@statsGrid([]statItem{
				{Label: "Input Tokens", Value: optInt64OrDash(data.Run.InputTokens)},
				{Label: "Output Tokens", Value: optInt64OrDash(data.Run.OutputTokens)},
				{Label: "Cost (USD)", Value: optCostOrDash(data.Run.CostUSD)},
			}, 3)
		}
		if data.Run.FinishedAt != nil {
			@runMetaStats(data.Run)
		}
		if data.Run.FinishedAt != nil && data.Run.Reason != nil && *data.Run.Reason != "" {
			<div class="mb-6">
				<div class="card bg-base-100 border border-base-200 shadow-sm">
					<div class="card-body p-4">
						<h2 class="card-title text-sm font-semibold text-base-content mb-1">Reason</h2>
						<pre class="text-xs font-mono break-all text-base-content/80" style="white-space: pre-wrap">@templ.Raw(ansiToHTML(*data.Run.Reason))</pre>
					</div>
				</div>
			</div>
		}
		if data.Run.CoveragePct != nil && data.Run.CoverageData != nil && *data.Run.CoverageData != "" {
			<div class="mb-6">
				<details class="collapse collapse-arrow bg-base-200 rounded-box">
					<summary class="collapse-title text-sm font-semibold">Coverage Detail</summary>
					<div class="collapse-content">
						@renderCoverageInline(data.Run.CoverageData)
					</div>
				</details>
			</div>
		}
		if len(data.Run.EnvVars) > 0 {
			<div class="mb-6">
				@collapseSection("Environment Variables") {
					@table.TableWithProps(table.TableProps{Size: "xs"}) {
						@table.TableHead() {
							@table.TableHeadRow() {
								@table.TableHeadCell("Key")
								@table.TableHeadCell("Value")
							}
						}
						@table.TableBody() {
							for _, key := range sortedKeys(data.Run.EnvVars) {
								<!-- lint:allow-raw -->
								<tr>
									<td class="font-semibold">{ key }</td>
									<!-- lint:allow-raw: env var table cells with dynamic content -->
									<td class="text-base-content/60 break-all">{ redactEnvValue(data.Run.EnvVars[key]) }</td>
								</tr>
							}
						}
					}
				}
			</div>
		}
		if len(data.MetaEvents) > 0 {
			<div class="mb-6">
				<h3 class="text-sm font-semibold text-base-content/60 uppercase mb-2">Metadata</h3>
				<div class="flex flex-wrap gap-2">
					for _, e := range data.MetaEvents {
						if e.Kind == "tag" {
							@metaTagBadges(e)
						} else if e.Kind == "state_change" {
							@metaStateChangeBadge(e)
						}
					}
				</div>
			</div>
		}
		@runDetailTabs(data)
		if data.IsActive && data.SSEURL != "" {
			<div id="run-status-observer" data-sse-url={ data.SSEURL } style="display:none"></div>
			<script>
				(function() {
					var el = document.getElementById('run-status-observer');
					var url = el.getAttribute('data-sse-url');
					var es = new EventSource(url);
					es.addEventListener('events-table', function(e) {
						var data = JSON.parse(e.data);
						if (data.full === 'true') {
							var section = document.getElementById('events-section');
							if (section) section.innerHTML = data.html;
						} else {
							var tbody = document.querySelector('#events-section tbody');
							if (tbody) tbody.insertAdjacentHTML('beforeend', data.html);
						}
					});
					es.addEventListener('done', function() {
						es.close();
						window.location.reload();
					});
					es.onerror = function() {
						es.close();
					};
				})();
			</script>
		}
	</div>
}

// eventsSection renders the events table, groups by section label, debug rows at top.
templ eventsSection(data runDetailData) {
	if len(data.SectionGroups) > 0 || len(data.MetaEvents) > 0 {
		@sectionedEventsTable(data)
	} else if data.IsActive {
		@emptyState("No events recorded yet. Waiting for test to emit events...")
	} else {
		@emptyState("No events recorded for this run. The test passed without emitting any timeline events.")
	}
}

templ sectionedEventsTable(data runDetailData) {
	@table.TableWithProps(table.TableProps{Size: "sm", Bordered: true}) {
		@table.TableHead() {
			@table.TableHeadRow() {
				<th class="text-xs font-semibold text-base-content/60 uppercase text-right w-12">Seq</th>
				@table.TableHeadCell("Kind")
				@table.TableHeadCell("Message")
				<th class="text-xs font-semibold text-base-content/60 uppercase text-right w-20">Elapsed</th>
			}
		}
		@table.TableBody() {
			if data.ShowDebug {
				for _, e := range data.MetaEvents {
					@flatEventRow(e, true)
				}
			}
			for gIdx, g := range data.SectionGroups {
				if g.Label != "" {
					<tr class="bg-base-200 cursor-pointer section-header" data-group-idx={ fmt.Sprintf("%d", gIdx) }>
						@table.TableCell("text-right w-12", nil) {
							<span class="text-base-content/40 text-xs">—</span>
						}
						@table.TableCell("", nil) {
							@ui.Badge(ui.BadgeProps{Label: "section", Variant: "primary", Size: ui.BadgeSizeSM})
						}
						@table.TableCell("", nil) {
							<span class="text-xs font-semibold text-base-content/70">{ g.Label }</span>
						}
						@table.TableCell("text-right w-20", nil) {
							<span class="text-base-content/40 text-xs">—</span>
						}
					</tr>
				}
				for _, e := range g.Events {
					@flatEventRow(e, false)
				}
			}
		}
	}
	<script>
		document.addEventListener('click', function(e) {
			var row = e.target.closest('tr.evt-row');
			if (!row) return;
			var eid = row.getAttribute('data-evt-id');
			if (!eid) return;
			var detail = document.getElementById('evt-detail-' + eid);
			if (!detail) return;
			detail.classList.toggle('hidden');
			if (!detail.classList.contains('hidden') && typeof hljs !== 'undefined') {
				var code = detail.querySelector('code');
				if (code) hljs.highlightElement(code);
			}
		});
	</script>
}

templ runDetailTabs(data runDetailData) {
	<div class="mb-4 mt-4">
		<div role="tablist" class="tabs tabs-bordered">
			<input type="radio" name="detail-tabs" class="tab" aria-label="Events" checked="checked" />
			<div role="tabpanel" class="tab-content p-0 pt-4">
				<div class="flex items-center justify-between mb-3">
					@sectionHeading("Events")
					<label class="flex items-center gap-2 cursor-pointer" data-testid="debug-toggle">
						<span class="text-xs text-base-content/60">Debug</span>
						<input
							type="checkbox"
							class="toggle toggle-xs"
							if data.ShowDebug {
								checked
							}
							onclick="document.getElementById('events-section').classList.toggle('debug-visible', this.checked)"
						/>
					</label>
				</div>
				<div
					id="events-section"
					if data.ShowDebug {
						class="debug-visible"
					}
				>
					@eventsSection(data)
				</div>
			</div>
			if data.RawOutput != "" {
				<input type="radio" name="detail-tabs" class="tab" aria-label="Raw Output" />
				<div role="tabpanel" class="tab-content p-0 pt-4">
					<pre class="font-mono text-xs whitespace-pre-wrap break-all max-h-96 overflow-auto bg-base-300 p-3 rounded border border-base-content/10">{ data.RawOutput }</pre>
				</div>
			}
		</div>
	</div>
}

templ metaTagBadges(e runlog.EventRow) {
	<div class="flex items-center gap-1 text-xs text-base-content/60 bg-base-200 px-2 py-1 rounded">
		<span class="font-semibold">tags:</span>
		@text(truncateMessage(e.Message, 60))
	</div>
}

templ metaStateChangeBadge(e runlog.EventRow) {
	<div class="flex items-center gap-1 text-xs text-base-content/60 bg-base-200 px-2 py-1 rounded">
		<span class="font-semibold">state:</span>
		@text(truncateMessage(e.Message, 60))
	</div>
}

// flatEventRow renders a single event row with client-side click-to-expand details.
templ flatEventRow(e runlog.EventRow, isDebug bool) {
	if isDebug {
		<tr
			id={ fmt.Sprintf("event-%d", e.ID) }
			class="is-debug-event opacity-50 bg-base-200/60 cursor-pointer hover:bg-base-300 transition-colors evt-row"
			data-testid={ "event-" + fmt.Sprintf("%d", e.ID) }
		>
			<td class="text-right w-12 italic">{ fmt.Sprintf("%d", e.Seq) }</td>
			<td>
				@ui.Badge(ui.BadgeProps{Label: e.Kind, Variant: runBadgeIntent("neutral"), Size: ui.BadgeSizeSM})
			</td>
			<td class="italic">{ truncateMessage(e.Message, 80) }</td>
			<td class="text-right w-20 italic">{ fmtElapsed(e.ElapsedS) }{ fmtDurationMs(e.DurationMs) }</td>
		</tr>
	} else {
		<tr
			id={ fmt.Sprintf("event-%d", e.ID) }
			class="hover cursor-pointer evt-row"
			data-evt-id={ fmt.Sprintf("%d", e.ID) }
			data-testid={ "event-" + fmt.Sprintf("%d", e.ID) }
		>
			@table.TableCell("text-right w-12", nil) {
				@text(fmt.Sprintf("%d", e.Seq))
			}
			@table.TableCell("", nil) {
				@ui.Badge(ui.BadgeProps{Label: e.Kind, Variant: runBadgeIntent(eventKindIntent(e.Kind)), Size: ui.BadgeSizeSM})
			}
			@table.TableCell("", nil) {
				@text(truncateMessage(e.Message, 80))
			}
			@table.TableCell("text-right w-28", nil) {
				@text(fmtElapsed(e.ElapsedS))
				@text(fmtDurationMs(e.DurationMs))
			}
		</tr>
	}
	if e.Details != nil && *e.Details != "" {
		<tr id={ fmt.Sprintf("evt-detail-%d", e.ID) } class="hidden evt-detail-row">
			<td colspan="4" class="bg-base-200 p-3">
				<div class="pl-12 border-l-2 border-base-300">
					@renderEventDetail(e.Kind, *e.Details)
				</div>
			</td>
		</tr>
	}
}

// eventRowOOB renders a single timeline event row as an OOB swap into the events table.
templ eventRowOOB(e runlog.EventRow) {
	<tr
		hx-swap-oob="beforeend:#events-section tbody"
		id={ fmt.Sprintf("event-%d", e.ID) }
		class="hover cursor-pointer evt-row"
		data-evt-id={ fmt.Sprintf("%d", e.ID) }
		data-testid={ "event-" + fmt.Sprintf("%d", e.ID) }
	>
		@table.TableCell("text-right w-12", nil) {
			@text(fmt.Sprintf("%d", e.Seq))
		}
		@table.TableCell("", nil) {
			@ui.Badge(ui.BadgeProps{Label: e.Kind, Variant: runBadgeIntent(eventKindIntent(e.Kind)), Size: ui.BadgeSizeSM})
		}
		@table.TableCell("", nil) {
			@text(truncateMessage(e.Message, 80))
		}
		@table.TableCell("text-right w-28", nil) {
			@text(fmtElapsed(e.ElapsedS))
			@text(fmtDurationMs(e.DurationMs))
		}
	</tr>
	if e.Details != nil && *e.Details != "" {
		<tr hx-swap-oob="beforeend:#events-section tbody" id={ fmt.Sprintf("evt-detail-%d", e.ID) } class="hidden evt-detail-row">
			<td colspan="4" class="bg-base-200 p-3">
				<div class="pl-12 border-l-2 border-base-300">
					@renderEventDetail(e.Kind, *e.Details)
				</div>
			</td>
		</tr>
	}
}

// sectionHeaderOOB renders a section header row as an OOB swap into the events table.
templ sectionHeaderOOB(label string) {
	<tr hx-swap-oob="beforeend:#events-section tbody" class="bg-base-200 cursor-pointer section-header">
		@table.TableCell("text-right w-12", nil) {
			<span class="text-base-content/40 text-xs">—</span>
		}
		@table.TableCell("", nil) {
			@ui.Badge(ui.BadgeProps{Label: "section", Variant: "primary", Size: ui.BadgeSizeSM})
		}
		@table.TableCell("", nil) {
			<span class="text-xs font-semibold text-base-content/70">{ label }</span>
		}
		@table.TableCell("text-right w-20", nil) {
			<span class="text-base-content/40 text-xs">—</span>
		}
	</tr>
}

// renderEventDetail renders the expanded detail panel for an event based on its kind.
// Replaces the old EventChildrenPartial + renderChildDetail split.
templ renderEventDetail(kind string, detailsJSON string) {
	if !isJSON(detailsJSON) {
		<div class="text-xs text-base-content/60">{ detailsJSON }</div>
	} else if kind == "gantt" {
		@renderGanttChart(0, detailsJSON)
	} else if kind == "http_call" {
		@renderHttpCall(detailsJSON)
	} else if kind == "cli" {
		@renderTopLevelCLI(detailsJSON)
	} else if kind == "artifact" {
		@renderArtifact(detailsJSON)
	} else if kind == "log" {
		@renderLogDetail(detailsJSON)
	} else if kind == "assertion" {
		@renderAssertionDetail(detailsJSON)
	} else if kind == "coverage" {
		@renderCoverage(detailsJSON)
	} else if kind == "pw_action" || kind == "pw_assert" || kind == "pw_step" {
		@renderPWEventDetail(kind, detailsJSON)
	} else if kind == "failure" {
		@renderFailureDetail(detailsJSON)
	} else {
		@renderedDetails(detailsJSON)
	}
}

func eventKindIntent(kind string) string {
	switch kind {
	case "section":
		return "primary"
	case "cli":
		return "warning"
	case "log":
		return "info"
	case "error":
		return "fail"
	case "pw_action":
		return "info"
	case "pw_assert":
		return "pass"
	case "pw_step":
		return "info"
	case "assertion":
		return "pass"
	case "http_call":
		return "accent"
	case "artifact":
		return "secondary"
	case "failure":
		return "fail"
	case "skip":
		return "skip"
	case "metric":
		return "pass"
	case "gantt":
		return "info"
	case "state_change":
		return "info"
	case "token_usage":
		return "info"
	default:
		return "info"
	}
}

func truncateMessage(msg string, maxLen int) string {
	msg = stripANSI(msg)
	if len(msg) <= maxLen {
		return msg
	}
	return msg[:maxLen] + "..."
}
