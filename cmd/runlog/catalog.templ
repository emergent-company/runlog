package main

import (
	"fmt"
	"net/url"
	"strconv"

	"github.com/emergent-company/go-daisy/components/table"
	runlog "github.com/emergent-company/runlog"
)

// CatalogPage/CatalogContent back the /ui/catalog page — one row per distinct
// test name, independent of run-history windows, showing each test's most
// recent classification (category/test_type/description) plus run stats.
templ CatalogPage(data catalogData) {
	@AppPage(fmt.Sprintf("Runlog - %s - Catalog", appName()), sidebarGroups) {
		@catalogContent(data)
	}
}

templ CatalogContent(data catalogData) {
	@catalogContent(data)
}

templ catalogContent(data catalogData) {
	<div data-testid="catalog-content">
		<h1 class="text-2xl font-bold mb-4">Catalog</h1>
		<form
			class="flex flex-wrap gap-3 mb-4 items-end"
			hx-get=CatalogURL()
			hx-target="[data-testid='catalog-content']"
			hx-trigger="change from:select, keyup changed delay:500ms from:input"
			hx-push-url="true"
		>
			<select
				class="select select-bordered select-sm w-full max-w-xs"
				name="category"
				data-testid="catalog-category-filter"
			>
				<option value="">All Categories</option>
				for _, cat := range data.Categories {
					if data.CategoryFilter == cat {
						<option value={ cat } selected>{ cat }</option>
					} else {
						<option value={ cat }>{ cat }</option>
					}
				}
			</select>
			<select
				class="select select-bordered select-sm w-full max-w-xs"
				name="test_type"
				data-testid="catalog-type-filter"
			>
				<option value="">All Types</option>
				for _, tt := range data.TestTypes {
					if data.TestTypeFilter == tt {
						<option value={ tt } selected>{ tt }</option>
					} else {
						<option value={ tt }>{ tt }</option>
					}
				}
			</select>
			<input
				type="text"
				name="search"
				placeholder="Search by name..."
				class="input input-bordered input-sm w-full max-w-xs"
				data-testid="catalog-search-filter"
				value={ data.Search }
			/>
		</form>
		<p class="text-sm text-base-content/60 mb-4">{ fmt.Sprintf("%d test(s)", len(data.Rows)) }</p>
		<div data-testid="catalog-list">
			if len(data.Rows) > 0 {
				@catalogTable(data.Rows)
			} else {
				@emptyState("No tests match filters.")
			}
		</div>
	</div>
}

// catalogTable renders one row per distinct test name (runlog.TestCatalogRow),
// reusing the same badge/pill helpers as the Tests and All Runs tables.
templ catalogTable(rows []runlog.TestCatalogRow) {
	@table.TableWithProps(table.TableProps{Size: "sm", Bordered: true}) {
		@table.TableHead() {
			@table.TableHeadRow() {
				@table.TableHeadCell("Test Name")
				@table.TableHeadCell("Category")
				@table.TableHeadCell("Type")
				@table.TableHeadCell("Tags")
				@table.TableHeadCell("Description")
				<th class="text-xs font-semibold text-base-content/60 uppercase text-right w-16">Runs</th> <!-- lint:allow-raw -->
				@table.TableHeadCell("Last Status")
				@table.TableHeadCell("Last Run At")
			}
		}
		@table.TableBody() {
			for _, row := range rows {
				<tr
					id={ "catalog-" + row.TestName }
					data-testid={ "catalog-row-" + row.TestName }
					class="hover"
					hx-get={ TestDetailURL(row.TestName) }
					hx-target="#main-content"
					hx-swap="innerHTML"
					hx-push-url="true"
					hx-sync="#main-content:replace"
				>
					@table.TableCell("", nil) {
						@text(row.TestName)
					}
					@table.TableCell("", nil) {
						<span class="badge badge-ghost badge-xs">{ displayCategory(row.Category) }</span>
					}
					@table.TableCell("", nil) {
						<span class={ testTypeBadge(row.TestType) }>{ displayTestType(row.TestType) }</span>
					}
					@table.TableCell("", nil) {
						@runTagPills(row.Tags)
					}
					@table.TableCell("", nil) {
						if row.Description != nil && row.Description.Summary != "" {
							<span class="text-sm text-base-content/70">{ truncateMessage(row.Description.Summary, 100) }</span>
						} else {
							<span class="text-base-content/30">—</span>
						}
					}
					@table.TableCell("text-right w-16", nil) {
						@text(strconv.Itoa(row.RunCount))
					}
					@table.TableCell("", nil) {
						@statusBadge(row.LastStatus)
					}
					@table.TableCell("", nil) {
						@text(formatTime(row.LastRunAt, TimeFull))
					}
				</tr>
			}
		}
	}
}
